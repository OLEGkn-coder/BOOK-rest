{
  "info": {
    "name": "Books REST API",
    "description": "Запити до REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. CRUD",
      "item": [
        {
          "name": "Отримати всі книги",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Є список книг\", () => pm.expect(body.books).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Додати книгу",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"David Thomas, Andrew Hunt\",\n  \"genre\": \"Програмування\",\n  \"year\": 2019,\n  \"price\": 1350,\n  \"totalCopies\": 2,\n  \"isbn\": \"978-0-13-595705-9\",\n  \"description\": \"Книга про практики розробки програм.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Книгу створено\", () => { pm.expect(body.id).to.be.a(\"string\"); pm.expect(body.availableCopies).to.eql(2); });",
                  "pm.collectionVariables.set(\"bookId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Отримати книгу за ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Той самий ID\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"bookId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Оновити книгу (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"David Thomas, Andrew Hunt\",\n  \"genre\": \"Програмування\",\n  \"year\": 2019,\n  \"price\": 1400,\n  \"totalCopies\": 3,\n  \"isbn\": \"978-0-13-595705-9\",\n  \"description\": \"Книга про практики розробки програм.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
