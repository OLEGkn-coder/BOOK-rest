        {
          "name": "Роки 1900-1950, лише доступні",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?minYear=1900&maxYear=1950&available=true",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "minYear",
                  "value": "1900"
                },
                {
                  "key": "maxYear",
                  "value": "1950"
                },
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Фільтр працює\", () => body.books.forEach((b) => { pm.expect(b.year).to.be.within(1900, 1950); pm.expect(b.availableCopies).to.be.above(0); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Друга сторінка по 5 книг",
