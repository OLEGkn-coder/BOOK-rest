                  "const body = pm.response.json();",
                  "pm.test(\"Дані оновлено\", () => { pm.expect(body.price).to.eql(1400); pm.expect(body.availableCopies).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Змінити ціну (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1299.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Змінено тільки ціну\", () => { pm.expect(body.price).to.eql(1299.99); pm.expect(body.title).to.eql(\"The Pragmatic Programmer\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
